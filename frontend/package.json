{
  "name": "juddges-frontend",
  "version": "1.3.0",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "deps:check": "node scripts/check-deps-in-sync.js",
    "predev": "npm run deps:check",
    "dev": "next dev --turbopack -p 3026",
    "dev:stable": "next dev -p 3026",
    "dev:clean": "rm -rf .next node_modules/.cache && next dev --turbopack -p 3026",
    "build": "next build",
    "postbuild": "node scripts/assert-retired-routes-absent.js",
    "gen:openapi": "openapi-typescript ../scripts/openapi-snapshot.json -o lib/api/generated/openapi.ts",
    "start": "next start -p 3006",
    "lint": "eslint app components contexts hooks lib types --ext .js,.jsx,.ts,.tsx",
    "test:document-types": "node scripts/validate-document-types.js",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "validate": "npm run deps:check && npm run test:document-types && npm run lint && npm run lint:route-contract-harness",
    "lint:route-contract-harness": "eslint playwright.route-contract.config.ts scripts/prepare-route-contract-standalone.mjs tests/route-contract-e2e tests/unit/test-harness/route-contract-harness.test.ts",
    "test": "jest",
    "test:local": "jest --runInBand --no-cache",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:production-contracts": "jest --config jest.production-contracts.config.js --coverage=false",
    "test:e2e": "playwright test",
    "prepare:e2e:route-contract": "node scripts/prepare-route-contract-standalone.mjs",
    "pretest:e2e:route-contract": "npm run prepare:e2e:route-contract",
    "start:e2e:route-contract": "node .next/standalone/frontend/server.js",
    "test:e2e:route-contract": "playwright test --config=playwright.route-contract.config.ts --max-failures=1",
    "test:e2e:smoke": "playwright test --project=chromium-ui-smoke --max-failures=3 --retries=1",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:chat": "playwright test tests/e2e/chat",
    "test:e2e:search": "playwright test tests/e2e/search",
    "test:e2e:documents": "playwright test tests/e2e/documents",
    "test:e2e:auth": "playwright test tests/e2e/auth",
    "test:e2e:api": "playwright test tests/e2e/api",
    "test:e2e:report": "playwright show-report",
    "docs:screens": "node scripts/docs/capture-screenshots.mjs"
  },
